# Copy to deploy/.env.prod ON THE SERVER (never commit it).
# Generate secrets with: openssl rand -hex 32
VOLUNTEER_HOST=volunteer.martinteran.me
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# Email verification. Ships off (false) until a Resend API key exists -- nothing is
# blocked in the meantime. Flip EMAIL_VERIFICATION_REQUIRED to true once RESEND_API_KEY
# is set, so verification emails actually have a way to send.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_BACKEND=console
# Send-only key for this app specifically -- don't reuse another app's Resend key.
RESEND_API_KEY=
